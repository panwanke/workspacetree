{
  "name": "@workspacetree/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @workspacetree/web dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --config .oxlintrc.json .",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,mts,json,md,yaml,html}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,mts,json,md,yaml,html}\" --ignore-path .prettierignore",
    "test": "vitest run",
    "generate:json-schema": "tsx packages/schema/scripts/generate-json-schema.ts",
    "generate:golden": "tsx tests/support/generate-golden.ts",
    "validate:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "22.20.5",
    "oxlint": "1.93.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
